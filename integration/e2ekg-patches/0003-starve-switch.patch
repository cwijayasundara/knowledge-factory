diff --git a/tests/agent/test_starve.py b/tests/agent/test_starve.py
new file mode 100644
index 0000000..19e4c13
--- /dev/null
+++ b/tests/agent/test_starve.py
@@ -0,0 +1,77 @@
+"""The knowledge-starved switch: with E2EKG_STARVE naming a removal list, every listed match
+text is deleted from its prompt file wherever prompt() reads it (the commander, the specialists,
+the fast path and the raw-only arm alike); unset, prompts are byte-identical to the files. A
+match the file does not contain, or a file that is not a prompt, fails loudly."""
+import json
+
+import pytest
+
+from e2ekg.agent.autorca import commander_prompt
+from e2ekg.agent.specialists import PROMPTS, STARVE_ENV, prompt
+
+COMMANDER = (PROMPTS / "autorca.md").read_text()
+MATCH = "Never invent a URI, a time or an application; cite only what a tool returned. "
+LOGS = (PROMPTS / "logs.md").read_text()
+LOGS_MATCH = LOGS.splitlines()[0]
+
+
+def removal(tmp_path, *items) -> str:
+    body = "".join(f"  - id: i{n}\n    file: {f}\n    match: {json.dumps(m)}\n"
+                   f"    why_derivable_from: catalog\n" for n, (f, m) in enumerate(items))
+    p = tmp_path / "removal.yaml"
+    p.write_text("items:\n" + body if items else "items: []\n")
+    return str(p)
+
+
+def test_unset_prompts_are_the_files(monkeypatch):
+    monkeypatch.delenv(STARVE_ENV, raising=False)
+    assert prompt("autorca") == COMMANDER and prompt("logs") == LOGS
+    assert commander_prompt(False) == COMMANDER
+
+
+def test_listed_text_is_removed_from_the_named_prompt(monkeypatch, tmp_path):
+    assert MATCH in COMMANDER and LOGS_MATCH
+    monkeypatch.setenv(STARVE_ENV, removal(tmp_path, ("prompts/autorca.md", MATCH),
+                                           ("prompts/logs.md", LOGS_MATCH)))
+    assert prompt("autorca") == COMMANDER.replace(MATCH, "")
+    assert MATCH not in commander_prompt() and MATCH not in commander_prompt(False, kf=True)
+    assert LOGS_MATCH not in prompt("logs")
+    assert prompt("traces") == (PROMPTS / "traces.md").read_text()
+
+
+def test_an_empty_list_changes_nothing(monkeypatch, tmp_path):
+    monkeypatch.setenv(STARVE_ENV, removal(tmp_path))
+    assert prompt("autorca") == COMMANDER
+
+
+def test_a_stale_match_fails_loudly(monkeypatch, tmp_path):
+    monkeypatch.setenv(STARVE_ENV, removal(tmp_path, ("prompts/autorca.md", "no such text")))
+    with pytest.raises(ValueError, match="did not match"):
+        prompt("autorca")
+    with pytest.raises(ValueError, match="did not match"):
+        prompt("logs")  # a stale item anywhere in the list stops every prompt
+
+
+def test_an_unknown_prompt_file_fails_loudly(monkeypatch, tmp_path):
+    monkeypatch.setenv(STARVE_ENV, removal(tmp_path, ("prompts/nope.md", "x")))
+    with pytest.raises(ValueError, match="names no prompt file"):
+        prompt("autorca")
+
+
+def test_a_missing_list_fails_loudly(monkeypatch, tmp_path):
+    monkeypatch.setenv(STARVE_ENV, str(tmp_path / "absent.yaml"))
+    with pytest.raises(FileNotFoundError):
+        prompt("autorca")
+
+
+@pytest.mark.parametrize("item", [("prompts/autorca.md", "zq-sentinel-text"), ("prompts/zqnofile.md", "x"),
+                                  ("not-a-prompt", "zq-sentinel-text")])
+def test_errors_never_name_the_item_text_file_or_list(monkeypatch, tmp_path, item):
+    """eval runs write str(e) into the run dir's errors.jsonl: nothing of the list may be in it."""
+    path = removal(tmp_path, item)
+    monkeypatch.setenv(STARVE_ENV, path)
+    with pytest.raises(ValueError) as e:
+        prompt("autorca")
+    msg = str(e.value)
+    for leak in ("i0", item[0], item[1], "zqnofile", path, "removal.yaml"):
+        assert leak not in msg, (leak, msg)
