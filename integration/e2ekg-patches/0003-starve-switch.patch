 def prompt(name: str) -> str:
-    return (PROMPTS / f"{name}.md").read_text()
+    """prompts/<name>.md; with E2EKG_STARVE set, minus the removal list's texts for that file."""
+    text = (PROMPTS / f"{name}.md").read_text()
+    path = os.environ.get(STARVE_ENV)
+    return starve(name, text, Path(path)) if path else text
+
+
+def starve(name: str, text: str, removal: Path) -> str:
+    """Delete every listed match for prompts/<name>.md from `text`. Every item in the list is
+    checked against its file on each call, so a stale list fails loudly instead of silently
+    removing nothing. Aliases reach the agent only as data (the catalog, via the Resolver), never
+    as a hint text, so prompt text is all the switch removes."""
+    from kf.evalx.removal import RemovalList
+
+    # Errors carry no item id, match text, prompt-file name or list path: eval runs write str(e) to
+    # errors.jsonl in the run dir, which a blind reviewer may browse.
+    if not removal.is_file():
+        raise FileNotFoundError("starve: the removal list (E2EKG_STARVE) is missing")
+    try:
+        items = RemovalList.load(removal).items
+    except Exception:
+        raise ValueError("starve: the removal list does not load or validate") from None
+    for n, item in enumerate(items, 1):
+        source = PROMPTS / item.file.removeprefix("prompts/")
+        if not source.is_file():
+            raise ValueError(f"starve: list entry #{n} names no prompt file (stale removal list)")
+        if item.match not in source.read_text():
+            raise ValueError(f"starve: list entry #{n} did not match a prompt (stale removal list)")
+        if item.file == f"prompts/{name}.md":
+            text = text.replace(item.match, "")
+    return text
 
 
