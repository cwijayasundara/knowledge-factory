diff --git a/tests/agent/test_kf_wiring.py b/tests/agent/test_kf_wiring.py
new file mode 100644
index 0000000..f2f05fe
--- /dev/null
+++ b/tests/agent/test_kf_wiring.py
@@ -0,0 +1,107 @@
+"""The knowledge factory's tools (kf_flag, kb_search, kb_read) wired into AutoRCA: with `kf`
+unset nothing changes; with it set the commander and every specialist get the three tools and
+prompts/kf.md, and a flag the agent raises lands in the factory's queue."""
+import pytest
+from agent_helpers import fake_tool_model, tool_names
+from kf.agent_tools import make_kf_tools
+from kf.flags.queue import FlagQueue
+from langchain_core.messages import AIMessage, HumanMessage, SystemMessage, ToolMessage
+
+from e2ekg.agent import autorca
+from e2ekg.agent.autorca import build_autorca, commander_prompt
+from e2ekg.agent.specialists import SPECIALISTS, build_specialists, prompt
+
+KF = {"kf_flag", "kb_search", "kb_read"}
+REPORT = {"verdict": "inconclusive", "hypotheses": [], "summary": "stub"}
+
+
+@pytest.fixture
+def kf(tmp_path):
+    return make_kf_tools(queue_path=tmp_path / "state" / "flags.db",
+                         bundle_snapshot=tmp_path / "bundle", run_id="hero__graph_kb__0",
+                         agent_id="autorca", scenario="hero")
+
+
+def commander_view(agent) -> tuple[set[str], str]:
+    """(the tools the commander is offered, its system prompt), from one scripted turn."""
+    seen = {}
+
+    def policy(messages, bound):
+        seen["tools"] = set(bound)
+        seen["system"] = next(m.content for m in messages if isinstance(m, SystemMessage))
+        return AIMessage("", tool_calls=[{"name": "RCAReport", "args": REPORT, "id": "r"}])
+    agent["model"].policy = policy
+    agent["agent"].invoke({"messages": [HumanMessage("go")]})
+    return seen["tools"], seen["system"]
+
+
+def built(h, llm, tmp_path, **kw):
+    model = fake_tool_model()
+    agent = build_autorca(h.store, h.proc, "hero", model=model, llm=llm,
+                          evidence_root=tmp_path / "evidence", **kw)
+    return {"agent": agent, "model": model}
+
+
+def test_without_kf_the_commander_is_unchanged(harvested_hero_as_of, scripted_llm, tmp_path):
+    tools, system = commander_view(built(harvested_hero_as_of, scripted_llm, tmp_path))
+    assert not tools & KF and set(autorca.COMMANDER_TOOLS) <= tools
+    assert prompt("kf") not in system
+    assert commander_prompt() == prompt("autorca") + "\n\n" + prompt("candidate_evidence")
+
+
+def test_with_kf_the_commander_gains_the_three_tools_and_the_note(harvested_hero_as_of,
+                                                                   scripted_llm, tmp_path, kf):
+    plain, _ = commander_view(built(harvested_hero_as_of, scripted_llm, tmp_path))
+    tools, system = commander_view(built(harvested_hero_as_of, scripted_llm, tmp_path, kf=kf))
+    assert tools == plain | KF
+    assert system.count(prompt("kf").strip()) == 1
+
+
+def test_without_kf_every_specialist_is_unchanged(harvested_hero_as_of, scripted_llm):
+    h = harvested_hero_as_of
+    for s in build_specialists(h.store, h.proc, "hero", llm=scripted_llm):
+        assert tool_names(s) == {*SPECIALISTS[s["name"]], "record_finding"}
+        assert s["system_prompt"] == prompt(s["name"])
+
+
+def test_with_kf_every_specialist_gains_the_three_tools_and_the_note(harvested_hero_as_of,
+                                                                     scripted_llm, kf):
+    h = harvested_hero_as_of
+    subs = build_specialists(h.store, h.proc, "hero", llm=scripted_llm, extra_tools=list(kf.values()),
+                             extra_prompt=prompt("kf"))
+    assert {s["name"] for s in subs} == set(SPECIALISTS)
+    for s in subs:
+        assert tool_names(s) == {*SPECIALISTS[s["name"]], "record_finding", *KF}
+        assert s["system_prompt"] == prompt(s["name"]) + "\n\n" + prompt("kf")
+
+
+def test_build_autorca_hands_kf_to_every_specialist(harvested_hero_as_of, scripted_llm, tmp_path,
+                                                    kf, monkeypatch):
+    got = {}
+    real = autorca.build_specialists
+
+    def spy(*a, **kw):
+        got.update(kw)
+        return real(*a, **kw)
+    monkeypatch.setattr(autorca, "build_specialists", spy)
+    built(harvested_hero_as_of, scripted_llm, tmp_path, kf=kf)
+    assert {t.name for t in got["extra_tools"]} == KF and got["extra_prompt"] == prompt("kf")
+
+
+def test_a_flag_the_commander_raises_reaches_the_queue(harvested_hero_as_of, scripted_llm,
+                                                       tmp_path, kf):
+    b = built(harvested_hero_as_of, scripted_llm, tmp_path, kf=kf)
+    replies = []
+
+    def policy(messages, bound):
+        done = [m for m in messages if isinstance(m, ToolMessage)]
+        if not done:
+            return AIMessage("", tool_calls=[{"name": "kf_flag", "id": "f", "args": {
+                "kind": "missing", "summary": "no alias for TMS"}}])
+        replies.append(done[-1].content)
+        return AIMessage("", tool_calls=[{"name": "RCAReport", "args": REPORT, "id": "r"}])
+    b["model"].policy = policy
+    b["agent"].invoke({"messages": [HumanMessage("go")]})
+    assert "continue" in replies[0].lower()
+    [flag] = FlagQueue(tmp_path / "state" / "flags.db").list()
+    assert (flag.run_id, flag.agent_id, flag.scenario) == ("hero__graph_kb__0", "autorca", "hero")
