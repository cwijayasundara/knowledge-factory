+def kf_env() -> tuple[Path, Path]:
+    """(the knowledge factory's state dir, its frozen bundle snapshot) for the graph_kb arm."""
+    missing = [k for k in KF_ENV if not os.environ.get(k)]
+    if missing:
+        raise RuntimeError(f"the {KB_ARM[0]} arm needs {' and '.join(missing)} set: "
+                           "KF_STATE_DIR holds the flag queue (flags.db), KF_BUNDLE_SNAPSHOT a "
+                           "frozen bundle snapshot directory")
+    state, snapshot = (Path(os.environ[k]) for k in KF_ENV)
+    if not snapshot.is_dir():
+        raise RuntimeError(f"KF_BUNDLE_SNAPSHOT is not a directory: {snapshot}")
+    return state, snapshot
+
+
+def kf_tools(case: Case, run_id: str) -> dict:
+    """kf_flag / kb_search / kb_read for one graph_kb run (kf is imported only here). The flags'
+    run id is <$KF_RUN_PREFIX>__<run name> when the prefix is set, else the run name."""
+    from kf.agent_tools import make_kf_tools
+    state, snapshot = kf_env()
+    prefix = os.environ.get(KF_RUN_PREFIX)
+    run_id = f"{prefix}__{run_id}" if prefix else run_id
+    return make_kf_tools(queue_path=state / "flags.db", bundle_snapshot=snapshot, run_id=run_id,
+                         agent_id="autorca", scenario=case.scenario)
+
