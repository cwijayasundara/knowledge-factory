+"""The opt-in graph_kb arm: the graph arm plus the knowledge factory's tools, over the flag queue
+in $KF_STATE_DIR and the frozen bundle in $KF_BUNDLE_SNAPSHOT. No network."""
+import pytest
+from agent_helpers import fake_tool_model
+from kf.flags.queue import FlagQueue
+from langchain_core.messages import AIMessage, ToolMessage
+
+from e2ekg.evals.arms import KB_ARM
+from e2ekg.evals.run import RunSpec, make_plan, resolve_arms, run_evals, run_one
+
+KF = {"kf_flag", "kb_search", "kb_read"}
+REPORT = {"verdict": "inconclusive", "hypotheses": [], "summary": "stub"}
+
+
+@pytest.fixture
+def kf_env(tmp_path, monkeypatch):
+    bundle = tmp_path / "snapshot"
+    (bundle / "domain").mkdir(parents=True)
+    (bundle / "domain" / "tms.md").write_text("---\ntitle: TMS\ndescription: d\n---\nTMS is tms-api\n")
+    monkeypatch.setenv("KF_STATE_DIR", str(tmp_path / "state"))
+    monkeypatch.setenv("KF_BUNDLE_SNAPSHOT", str(bundle))
+    return tmp_path
+
+
+def test_graph_kb_is_opt_in_and_planned_as_an_llm_arm():
+    assert KB_ARM == ("graph_kb",)
+    assert "graph_kb" not in resolve_arms("all") and resolve_arms("graph_kb") == ["graph_kb"]
+    [spec] = make_plan(["hero"], 1, ["graph_kb"])
+    assert spec.name == "hero__graph_kb__0" and spec.llm
+
+
+@pytest.mark.parametrize("unset", ["KF_STATE_DIR", "KF_BUNDLE_SNAPSHOT"])
+def test_graph_kb_refuses_to_run_without_its_environment(eval_root, kf_env, monkeypatch, unset):
+    monkeypatch.delenv(unset)
+    with pytest.raises(RuntimeError, match=unset):
+        run_one(RunSpec("hero", "graph_kb", 0), root=eval_root, evals_dir=eval_root / "evals",
+                model=fake_tool_model())
+    with pytest.raises(RuntimeError, match=unset):
+        run_evals(["hero"], 1, ["graph_kb"], root=eval_root, run_dir=kf_env / "run",
+                  model=fake_tool_model(), say=lambda _: None)
+    assert not (kf_env / "run").exists()
+
+
+def test_graph_kb_is_graph_plus_the_kf_tools_and_flags_carry_the_run_name(eval_root, kf_env):
+    offered = {}
+    for arm in ("graph", "graph_kb"):
+        seen, replies = [], []
+
+        def policy(messages, bound):
+            seen.append(bound)
+            done = [m for m in messages if isinstance(m, ToolMessage)]
+            if "kf_flag" in bound and not done:
+                return AIMessage("", tool_calls=[{"name": "kf_flag", "id": "f", "args": {
+                    "kind": "missing", "summary": "no alias for TMS"}}])
+            replies.extend(m.content for m in done)
+            return AIMessage("", tool_calls=[{"name": "RCAReport", "args": REPORT, "id": "r"}])
+        run = run_one(RunSpec("hero", arm, 0), root=eval_root, evals_dir=eval_root / "evals",
+                      model=fake_tool_model(policy))
+        assert run["report"]["summary"] == "stub"
+        offered[arm] = set().union(*seen)
+    assert offered["graph_kb"] == offered["graph"] | KF
+    [flag] = FlagQueue(kf_env / "state" / "flags.db").list()
+    assert (flag.run_id, flag.agent_id, flag.scenario) == ("hero__graph_kb__0", "autorca", "hero")
+    assert any("continue" in r.lower() for r in replies)
+
+
+def test_graph_kb_run_id_carries_the_factory_prefix(eval_root, kf_env, monkeypatch):
+    """KF_RUN_PREFIX (the factory's split, eval stamp and seed) prefixes the run id, so flags from
+    different seeds or invocations never share a run id (the queue de-duplicates and caps per run id)."""
+    monkeypatch.setenv("KF_RUN_PREFIX", "curation-20261122T000000Z-seed11")
+
+    def policy(messages, bound):
+        if not [m for m in messages if isinstance(m, ToolMessage)]:
+            return AIMessage("", tool_calls=[{"name": "kf_flag", "id": "f", "args": {
+                "kind": "missing", "summary": "no alias for TMS"}}])
+        return AIMessage("", tool_calls=[{"name": "RCAReport", "args": REPORT, "id": "r"}])
+    run_one(RunSpec("hero", "graph_kb", 0), root=eval_root, evals_dir=eval_root / "evals",
+            model=fake_tool_model(policy))
+    [flag] = FlagQueue(kf_env / "state" / "flags.db").list()
+    assert flag.run_id == "curation-20261122T000000Z-seed11__hero__graph_kb__0"
