+"use client";
+import FactoryDiagram from "@/components/FactoryDiagram";
+
+export default function Factory() {
+  return (
+    <>
+      <h1>Knowledge factory</h1>
+      <div className="sub">Agents that do the work notice what they don't know. A separate curator agent fixes the knowledge, humans approve it, and the next run starts smarter.</div>
+      <div className="grid g3" style={{ marginBottom: 14 }}>
+        <div className="card"><h2>1. Working agents flag</h2><div className="mut">AutoRCA calls kf_flag when knowledge is missing or wrong.</div></div>
+        <div className="card"><h2>2. A curator agent fixes</h2><div className="mut">It re-derives claims from raw sources and proposes a branch; it never writes "verified".</div></div>
+        <div className="card"><h2>3. A knowledge store holds</h2><div className="mut">OKF concepts and SKILL.md skills in git, reviewed before merge.</div></div>
+      </div>
+      <div className="card"><FactoryDiagram /></div>
+    </>
+  );
+}
